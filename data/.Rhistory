) +
# 2) Wide "mask" strata: same width as flows, fill = background,
#    so they trim the flows exactly at the axis
geom_stratum(
width  = 0.02,
color  = NA,
fill   = bg_col,
alpha  = 1
) +
# 3) Narrow visible strata on top
