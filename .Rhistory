calculate_site_overlap <- function(data, species_col) {
site_species <- data %>%
group_by(Original_Reference, Site) %>%
summarise(
species = list(unique(.data[[species_col]])),
.groups = "drop"
)
site_species %>%
group_by(Original_Reference) %>%
summarise(
site_pairs = list(combn(Site, 2, simplify = FALSE)),
species_lists = list(set_names(species, Site)),
.groups = "drop"
) %>%
unnest(site_pairs) %>%
rowwise() %>%
mutate(
site_1 = site_pairs[1],
site_2 = site_pairs[2],
species_1 = list(species_lists[[site_1]]),
species_2 = list(species_lists[[site_2]]),
n_shared = length(intersect(species_1, species_2)),
n_total = length(union(species_1, species_2)),
jaccard_overlap = ifelse(n_total > 0, n_shared / n_total, NA_real_)
) %>%
ungroup() %>%
select(
Original_Reference,
site_1,
site_2,
n_shared,
n_total,
jaccard_overlap
)
}
plant_site_overlap <- calculate_site_overlap(
data = df_eligible,
species_col = "Plant_POWO"
) %>%
rename(
plant_n_shared = n_shared,
plant_n_total = n_total,
plant_jaccard_overlap = jaccard_overlap
)
animal_site_overlap <- calculate_site_overlap(
data = df_eligible,
species_col = "Animal_accepted"
) %>%
rename(
animal_n_shared = n_shared,
animal_n_total = n_total,
animal_jaccard_overlap = jaccard_overlap
)
interaction_site_overlap <- calculate_site_overlap(
data = df_eligible,
species_col = "interaction_id"
) %>%
rename(
interaction_n_shared = n_shared,
interaction_n_total = n_total,
interaction_jaccard_overlap = jaccard_overlap
)
# Detailed pairwise overlap table
site_overlap_detailed <- plant_site_overlap %>%
full_join(
animal_site_overlap,
by = c("Original_Reference", "site_1", "site_2")
) %>%
full_join(
interaction_site_overlap,
by = c("Original_Reference", "site_1", "site_2")
)
site_overlap_summary <- site_overlap_detailed %>%
group_by(Original_Reference) %>%
summarise(
n_site_pairs = n(),
# Jaccard overlap
mean_plant_overlap = mean(plant_jaccard_overlap, na.rm = TRUE),
sd_plant_overlap = sd(plant_jaccard_overlap, na.rm = TRUE),
min_plant_overlap = min(plant_jaccard_overlap, na.rm = TRUE),
max_plant_overlap = max(plant_jaccard_overlap, na.rm = TRUE),
mean_animal_overlap = mean(animal_jaccard_overlap, na.rm = TRUE),
sd_animal_overlap = sd(animal_jaccard_overlap, na.rm = TRUE),
min_animal_overlap = min(animal_jaccard_overlap, na.rm = TRUE),
max_animal_overlap = max(animal_jaccard_overlap, na.rm = TRUE),
mean_interaction_overlap = mean(interaction_jaccard_overlap, na.rm = TRUE),
sd_interaction_overlap = sd(interaction_jaccard_overlap, na.rm = TRUE),
min_interaction_overlap = min(interaction_jaccard_overlap, na.rm = TRUE),
max_interaction_overlap = max(interaction_jaccard_overlap, na.rm = TRUE),
# Number of shared plant species
mean_shared_plants = mean(plant_n_shared, na.rm = TRUE),
sd_shared_plants = sd(plant_n_shared, na.rm = TRUE),
min_shared_plants = min(plant_n_shared, na.rm = TRUE),
max_shared_plants = max(plant_n_shared, na.rm = TRUE),
# Number of shared animal species
mean_shared_animals = mean(animal_n_shared, na.rm = TRUE),
sd_shared_animals = sd(animal_n_shared, na.rm = TRUE),
min_shared_animals = min(animal_n_shared, na.rm = TRUE),
max_shared_animals = max(animal_n_shared, na.rm = TRUE),
# Number of shared interactions
