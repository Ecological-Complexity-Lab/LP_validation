soons_pairwise <- soons_pair_plants %>%
left_join(soons_pair_animals, by = c("Original_Reference", "site_1", "site_2")) %>%
left_join(distinct(soons, Site, Country), by = c("site_1" = "Site")) %>%
rename(country_1 = Country) %>%
left_join(distinct(soons, Site, Country), by = c("site_2" = "Site")) %>%
rename(country_2 = Country)
soons_pairwise
# Score each region: composite of n_sites, species richness, plant and animal overlap
# Min-max normalization so a single-region result returns 0.5 rather than NaN
normalize_minmax <- function(x) {
r <- range(x, na.rm = TRUE)
if (r[1] == r[2]) return(rep(0.5, length(x)))
(x - r[1]) / (r[2] - r[1])
}
region_ranking <- soons_pairwise %>%
filter(country_1 == country_2) %>%
group_by(country_1) %>%
summarise(
mean_plant_jaccard    = mean(plant_jaccard,    na.rm = TRUE),
mean_animal_jaccard   = mean(animal_jaccard,   na.rm = TRUE),
mean_shared_plants    = mean(plant_n_shared,   na.rm = TRUE),
mean_shared_animals   = mean(animal_n_shared,  na.rm = TRUE),
.groups = "drop"
) %>%
rename(Country = country_1) %>%
left_join(region_species_pool, by = "Country") %>%
mutate(
composite_score = normalize_minmax(region_n_sites) +
normalize_minmax(region_total_species) +
normalize_minmax(mean_plant_jaccard) +
normalize_minmax(mean_animal_jaccard)
) %>%
arrange(desc(composite_score))
region_ranking
best_country <- region_ranking %>%
slice_max(composite_score, n = 1) %>%
pull(Country)
soons_best_region <- soons %>%
filter(Country == best_country)
soons_best_region
best_country
